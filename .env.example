# ===========================================
# Email to Telegram Bot - Configuration
# ===========================================

# ------------------------------------------
# Required Settings
# ------------------------------------------

# Telegram Bot Token (get it from @BotFather)
TELEGRAM_BOT_TOKEN=123456:ABC-DEF...

# Encryption key for storing passwords (MUST be exactly 32 characters)
# Generate with: openssl rand -base64 24 | head -c 32
ENCRYPTION_KEY=change-me-to-32-random-chars-now

# ------------------------------------------
# Telegram Settings (optional)
# ------------------------------------------

# Send emails as rich messages (Bot API 10.1+): headings, lists, quotes,
# collapsible long emails. Falls back to plain HTML messages automatically.
TELEGRAM_RICH_MESSAGES=true

# Local Bot API server (https://github.com/tdlib/telegram-bot-api), empty = api.telegram.org
TELEGRAM_API_URL=

# ------------------------------------------
# Database Settings
# ------------------------------------------

# Path to SQLite database file
DATABASE_PATH=./data/emailbot.db

# ------------------------------------------
# Email Settings (optional)
# ------------------------------------------

# IMAP IDLE timeout (default: 25m)
# Most servers support up to 29 minutes
IMAP_IDLE_TIMEOUT=25m

# Connection timeout for IMAP server (default: 30s)
IMAP_DIAL_TIMEOUT=30s

# Max time between mailbox checks. New mail normally arrives instantly via
# IMAP IDLE; this is a safety net and the polling interval for servers
# without IDLE support (default: 1m)
EMAIL_POLL_INTERVAL=1m

# ------------------------------------------
# Mailcow Integration (optional)
# ------------------------------------------
# Leave these empty to disable Mailcow integration
# When disabled, /create command will not be available

# Mailcow server URL (e.g., https://mail.example.com)
MAILCOW_URL=

# Mailcow API key (get from Mailcow Admin -> API)
MAILCOW_API_KEY=

# Default domain for new mailboxes (e.g., example.com)
MAILCOW_DOMAIN=

# IMAP server of created mailboxes, host:port (default: MAILCOW_URL host, port 993)
MAILCOW_IMAP_SERVER=

# Quota of created mailboxes in MB (default: the domain's default quota)
MAILCOW_MAILBOX_QUOTA_MB=

# ------------------------------------------
# Logging Settings (optional)
# ------------------------------------------

# Log level: debug, info, warn, error (default: info)
LOG_LEVEL=info

# Log format: text (colored) or json (default: text)
LOG_FORMAT=text
